# Environment variables read by aninest-mcp.
# Copy to .env (never commit .env) or export them in your shell.

# --- transport ---------------------------------------------------------------
# stdio (default, for desktop clients) | streamable-http | sse
ANINEST_MCP_TRANSPORT=stdio
ANINEST_MCP_HOST=127.0.0.1
ANINEST_MCP_PORT=8765

# --- image board -------------------------------------------------------------
# Any Gelbooru-style JSON API works; safebooru is the default because it is
# reachable without a proxy and only serves safe-rated posts.
ANINEST_BOORU_URL=https://safebooru.org/index.php
ANINEST_HTTP_TIMEOUT=15
ANINEST_USER_AGENT=aninest-mcp/0.3.0 (+https://github.com/moriruruka/aninest-mcp)

# --- local services ----------------------------------------------------------
# Browser service that holds the logged-in arena session (AniNest runtime).
ANINEST_ARENA_URL=http://127.0.0.1:6191
# Read-only path to the assistant's SQLite memory database.
ANINEST_MEMORY_DB=C:/Users/you/.aninest/memory.db
# Host probed by the service_health tool.
ANINEST_PROBE_HOST=127.0.0.1

# --- portrait matching (optional) -------------------------------------------
# Directory of character avatars named <six-digit-id>.webp / .png / .jpg,
# e.g. 100701.webp. Game art is not redistributed with this repo, so point this
# at your own folder; leave empty to disable portrait_identify.
# Needs the optional extra: pip install -e ".[vision]"
ANINEST_PCR_AVATARS=
